{
  "payload": {
    "export": "cart-validations-generate-run",
    "target": "cart.validations.generate.run",
    "input": {
      "buyerJourney": {
        "step": "CHECKOUT_INTERACTION"
      },
      "cart": {
        "lines": [{ "id": "gid://shopify/CartLine/1" }],
        "cost": { "subtotalAmount": { "amount": "50.0" } },
        "buyerIdentity": { "customer": { "hasAnyTag": true } }
      },
      "shop": {
        "metafield": {
          "jsonValue": { "active": true, "b2bMinOrder": 200 }
        }
      }
    },
    "output": {
      "operations": [
        {
          "validationAdd": {
            "errors": [
              {
                "message": "B2B minimum order is 200. Current subtotal: 50.",
                "target": "$.cart"
              }
            ]
          }
        }
      ]
    }
  }
}
