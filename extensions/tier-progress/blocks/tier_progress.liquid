{% comment %}
  App Block: progress toward discount and gift thresholds from $app.tier_rules.
{% endcomment %}

{% liquid
  assign rules_mf = shop.metafields['$app'].tier_rules.value
  assign has_rules = false
  assign threshold = 0
  assign gift_threshold = 0
  assign discount_pct = 0
  assign cart_total = cart.items_subtotal_price | default: cart.original_total_price | default: cart.total_price | divided_by: 100.0

  if rules_mf and rules_mf.threshold and rules_mf.giftThreshold
    assign has_rules = true
    assign threshold = rules_mf.threshold | times: 1.0
    assign gift_threshold = rules_mf.giftThreshold | times: 1.0
    if rules_mf.percentOff
      assign discount_pct = rules_mf.percentOff | times: 1.0
    endif
  endif
%}

<div
  id="TierProgress-{{ block.id }}"
  class="tier-progress"
  data-has-rules="{% if has_rules %}true{% else %}false{% endif %}"
  data-threshold="{{ threshold }}"
  data-gift-threshold="{{ gift_threshold }}"
  data-discount-pct="{{ discount_pct }}"
  data-cart-total="{{ cart_total }}"
  {{ block.shopify_attributes }}
>
  <p class="tier-progress__title">{{ block.settings.heading }}</p>

  {% if has_rules %}
    <div class="tier-progress__row" data-row="discount">
      <div class="tier-progress__labels">
        <span data-label-discount>Discount {{ discount_pct | round }}%</span>
        <span class="tier-progress__status" data-status-discount></span>
      </div>
      <div class="tier-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="tier-progress__fill" data-fill-discount style="width: 0%">&nbsp;</span>
      </div>
    </div>

    <div class="tier-progress__row" data-row="gift">
      <div class="tier-progress__labels">
        <span>Free gift</span>
        <span class="tier-progress__status" data-status-gift></span>
      </div>
      <div class="tier-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="tier-progress__fill tier-progress__fill--gift" data-fill-gift style="width: 0%">&nbsp;</span>
      </div>
    </div>
  {% else %}
    <p class="tier-progress__empty">Configure tier rules in the app to show progress.</p>
  {% endif %}
</div>

{% style %}
  #TierProgress-{{ block.id }} {
    margin: 1.25rem 0;
    padding: 1rem 0;
    font-size: 1.05rem;
    line-height: 1.4;
    color: #1a1a1a;
  }
  #TierProgress-{{ block.id }} .tier-progress__title {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 650;
  }
  #TierProgress-{{ block.id }} .tier-progress__row + .tier-progress__row {
    margin-top: 1.15rem;
  }
  #TierProgress-{{ block.id }} .tier-progress__labels {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.55rem;
    font-size: 1.05rem;
  }
  #TierProgress-{{ block.id }} .tier-progress__status.is-complete {
    color: #1f7a3f;
    font-weight: 600;
  }
  #TierProgress-{{ block.id }} .tier-progress__track {
    display: block !important;
    width: 100%;
    height: 12px;
    min-height: 12px;
    background-color: #e4e4e4 !important;
    border: 1px solid #c8c8c8;
    border-radius: 999px;
    overflow: hidden;
  }
  #TierProgress-{{ block.id }} .tier-progress__fill {
    display: block !important;
    height: 100%;
    min-height: 10px;
    background-color: #1a1a1a !important;
    border-radius: 999px;
    transition: width 0.25s ease, background-color 0.25s ease;
    line-height: 0;
    font-size: 0;
  }
  #TierProgress-{{ block.id }} .tier-progress__fill--gift {
    background-color: #2f6fed !important;
  }
  #TierProgress-{{ block.id }} .tier-progress__fill.is-complete {
    background-color: #1f7a3f !important;
  }
{% endstyle %}

{% schema %}
{
  "name": "Tier progress",
  "target": "section",
  "stylesheet": "tier-progress.css",
  "javascript": "tier-progress.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your rewards progress"
    }
  ]
}
{% endschema %}
