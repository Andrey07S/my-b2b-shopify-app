# Shopify app credentials (Partner Dashboard → App → Client credentials)
# Or pull via: shopify app env
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.com

# Must match scopes in shopify.app.toml
SCOPES=read_customers,read_discounts,read_orders,read_products,read_validations,write_cart_transforms,write_customers,write_discounts,write_validations

# Optional: custom shop domain for auth
# SHOP_CUSTOM_DOMAIN=
