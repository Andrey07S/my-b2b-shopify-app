# Local: enough for Prisma. SHOPIFY_* come from shopify app dev + local toml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_b2b_smart_app?schema=public

# Staging (Render) — set in the host dashboard, not required locally:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=https://your-service.onrender.com
# SCOPES=read_customers,read_discounts,read_orders,read_products,read_validations,write_cart_transforms,write_customers,write_discounts,write_validations
